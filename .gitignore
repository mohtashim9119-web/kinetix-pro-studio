node_modules/
dist/
.env
.env.local
.env.*.local
.DS_Store
*.log
.vscode/
.idea/
.claude/
kinetix-video-studio.zip

# Tauri sidecar binaries — built locally, not committed (large, platform-specific)
src-tauri/binaries/ffmpeg-*
src-tauri/binaries/whisper-*

# Whisper model files — too large for git (141 MB+); see src-tauri/models/README.md
src-tauri/models/*.bin

# Bundled onnxruntime C runtime for forced alignment — too large for git (~39 MB,
# platform-specific); manifest + README committed, dylib re-provisioned. See
# src-tauri/onnxruntime/README.md (WS1 Session M, ruling R-N).
src-tauri/onnxruntime/*.dylib
src-tauri/onnxruntime/onnxruntime-osx-*

# WebCodecs Phase 0 spike — throwaway test asset, never committed (see docs/webcodecs-architecture-plan.md)
public/_spike/

# WS2-23 dev seed fixture — a local scratch project used to hand-load a test
# project into the dashboard. Swept into the repo by a wildcard `git add -A`;
# public/ has been out of scope since Phase 3 and stays untracked.
public/ws2-23-seed.json

# Python bytecode cache — scripts/ has measurement tooling (measure-word-onset.py, measure-forced-alignment.py)
__pycache__/
*.pyc

# WS2-49 measurement script output — regenerated by measure_orphans.py, not source
scripts/ws2-49-measurement/*.json

# Blinded listening-clip batches + their private answer keys (Phase 3/4 sync
# measurement). Kept OUT of docs/ so a listener cannot see the key, and out of
# /tmp so they survive cleanup -- see the K8 pattern in docs/sync-pipeline-v2-plan.md
.listening-clips/
.answer-keys/
.venv-phase4/
.venv-phase4-fa/
# 2026-09-19 P1 gate-integrity pass — replay/ fixtures are irreplaceable
# (P2 sweep) and gate scripts/phase4-restore-replay-inputs.py's regeneration
# path for the v6/173/spanish trio; tracked so the machine-dependent npm
# gate no longer depends on a fixture that only exists in the main worktree.
# Everything else under .work-phase4/ (session backups, step-*.json scratch)
# stays ignored — a parent-dir exclude can't be re-included by a child
# negation, so this uses .work-phase4/* instead of .work-phase4/.
.work-phase4/*
!.work-phase4/replay/
!.work-phase4/replay/**

# graphify tool output — regeneratable, not source (2026-08-07)
graphify-out/

# Durable vitest/cargo failure records (WS3 Round 8) — gitignored on purpose.
# Vitest reporter writes only on a failing run; scripts/ws3-record-test-run.mjs
# writes cargo (and filtered vitest) arithmetic. See docs/ws3-export-durable-state.md.
.ws3-test-failures/

# Cloud ASR proof-of-concept audio fixtures — never commit (WS cloud-asr).
cloud/fixtures/

# Local measurement dumps (token streams, nvidia-smi logs). Regenerable.
cloud/results/
