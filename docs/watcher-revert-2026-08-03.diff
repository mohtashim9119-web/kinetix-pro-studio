+      boundaryAmplitude > k * quietest.meanAmplitude
+    : false;
+
+  // Defect C — centered placement. Only meaningful when a quiet region was
+  // actually found; expands from that seed, clamped to this pair's own WIDE
+  // search window (`window.searchStart`/`window.searchEnd` — the same window
+  // `findQuietestRegion` just searched to find `quietest.time`), NOT the
+  // narrower real token gap (`lastSpokenEnd`/`nextSpokenStart`) — correction
+  // placement semantics fix, 2026-08-02: clamping the region search to the
+  // gap silently discarded the real measured quiet moment whenever it fell
+  // outside the transcribed gap (Whisper timestamp imprecision routinely
+  // puts it there), forcing a fallback to the gap's own midpoint — the same
+  // "re-commit onto ordinary speech" failure this checker exists to catch.
+  // See `findSilenceRegionCenter`'s own doc comment for the full rationale
+  // and the production fixture (gap [20.36s,20.64s], real quiet ~20.95s)
+  // that motivated it. `resolveCorrectionCandidate` (below) classifies the
+  // resulting `center` as exact or approximate depending on whether it still
+  // lands inside `lastSpokenEnd`/`nextSpokenStart`; it never re-clamps it.
+  // `regionEndThreshold` is an ABSOLUTE delta added to the quietest span's
+  // own mean amplitude — FROZEN 2026-08-02 from the V6 centering sweep (see
+  // BOUNDARY_QUALITY_REGION_END_DELTA's own comment, syncConstants.ts, for
+  // why a RATIO threshold was rejected: it collapses to a single-column fake
+  // region whenever quietest.meanAmplitude is near-zero, a common case for
+  // genuine digital-silence pauses).
+  let region: SilenceRegionCenter | undefined;
+  if (quietest.found && quietest.time !== undefined && quietest.meanAmplitude !== undefined) {
+    const regionEndThreshold = quietest.meanAmplitude + BOUNDARY_QUALITY_REGION_END_DELTA;
+    region = findSilenceRegionCenter(
+      waveformSource.peaks, waveformSource.peaksPerSecond,
+      quietest.time, regionEndThreshold, window.searchStart, window.searchEnd,
+    );
+  }
+
+  return {
+    segmentIndex,
+    boundaryTime,
+    boundaryAmplitude,
+    quietestTime: quietest.time,
+    quietestAmplitude: quietest.meanAmplitude,
+    windowStart: window.searchStart,
+    windowEnd: window.searchEnd,
+    flagged,
+    usedFallback,
+    lastSpokenEnd,
+    nextSpokenStart,
+    regionStart: region?.regionStart,
+    regionEnd: region?.regionEnd,
+    center: region?.center,
+  };
+}
+
+/**
+ * Fallback-only filter over `measureBoundaryQuality` — every existing caller
+ * (`validateBoundaryQuality`'s Phase 1 checker, `applyBoundaryWatcher`'s
+ * Phase 2 corrector) wants ONLY boundaries `snapCoveredBoundaries` placed via
+ * the plain spoken-edge-midpoint fallback (a silence-placed boundary is
+ * already acoustic ground truth and out of scope for either of them). A
+ * one-line wrapper so their behavior stays byte-identical to before
+ * `measureBoundaryQuality` existed.
+ *
+ * Pure; exported for direct unit testing.
+ */
+export function measureFallbackBoundary(
+  segmentIndex: number,
+  curr: VideoSegment,
+  next: VideoSegment,
+  currAlign: SegmentAlignment,
+  nextAlign: SegmentAlignment,
+  tokens: TranscriptToken[],
+  silences: SilenceInterval[],
+  waveformSource: WaveformSource,
+  k: number,
+  sustainedWindowSec: number,
+): BoundaryQualityMeasurement | null {
+  const m = measureBoundaryQuality(
+    segmentIndex, curr, next, currAlign, nextAlign, tokens, silences, waveformSource, k, sustainedWindowSec,
+  );
+  return m && m.usedFallback ? m : null;
+}
+
+/** Which of `resolveCorrectionCandidate`'s two placement tiers actually
+ *  produced the returned target — surfaced so a caller can log/DEV-warn on
+ *  the approximate tier without recomputing the same comparison. */
+export type CorrectionCandidateSource = 'center' | 'region-center-approximate';
+
+export interface CorrectionCandidate {
+  target: number;
+  source: CorrectionCandidateSource;
+  /** `true` when `target` lies outside the pair's own transcribed token gap
+   *  (`lastSpokenEnd`/`nextSpokenStart`) — a real measured quiet spot the
+   *  script's word timestamps didn't predict, not a containment fallback.
+   *  `false` for the ideal tier-1 case. Carried onto `BoundaryCorrection`
+   *  once a caller actually commits the write, so the sync log can tell the
+   *  user which corrections were exact vs. approximate. */
+  approximate: boolean;
+}
+
+/**
+ * Correction placement semantics fix (2026-08-02) — resolves the position a
+ * FLAGGED boundary's correction should target, for a measurement that
+ * already has a region computed (`measureBoundaryQuality`'s `regionStart`/
+ * `regionEnd`/`center`). Two placement tiers plus an explicit "no placement"
+ * outcome:
+ *
+ *   1. `center` itself, when it sits STRICTLY inside the pair's own real
+ *      token gap (`lastSpokenEnd`/`nextSpokenStart`) — the ideal case,
+ *      `approximate: false`.
+ *   2. `center` ANYWAY, when it landed outside the gap (or the found region
+ *      collapsed to something degenerate near a gap edge) — `center` is
+ *      always a REAL measured quiet spot (`findSilenceRegionCenter`'s
+ *      expansion from `findQuietestRegion`'s seed), never a synthesized
+ *      point, so it is used as-is, `approximate: true`. The caller (`
+ *      applyBoundaryWatcher`/`verifyCommittedBoundaries`) still enforces the
+ *      real hard safety bounds before committing it (see below).
+ *   3. `null` — no quiet region was found AT ALL (`quietest.found` was
+ *      `false`, so `m.center` itself is `undefined`; see `findQuietestRegion`'s
+ *      own doc comment). There is nothing to place a correction at; the
+ *      caller must skip this pair and report it as a real, user-facing
+ *      warning instead of silently keeping (or worse, midpoint-guessing) a
+ *      proven-bad boundary.
+ *
+ * Rationale (this is the load-bearing design decision this fix changes, not
+ * an incidental detail): a flagged boundary already sits on PROVEN-BAD loud
+ * audio — that is what "flagged" means. A PRIOR revision of this function
+ * clamped an out-of-gap `center` back INTO the gap, or substituted the gap's
+ * own plain midpoint, on the theory that staying inside the transcribed gap
+ * was always safer. In practice both of those re-commit the boundary onto
+ * ordinary speech whenever the real quiet audio sits outside the gap — which
+ * happens routinely, since Whisper word timestamps carry real error (a
+ * production pair with transcribed gap [20.36s,20.64s] had its actual quiet
+ * moment at ~20.95s; clamping/midpointing landed at ~20.50s, on speech) —
+ * i.e. the EXACT failure this whole checker exists to catch, just logged as
+ * "auto-adjusted" instead of surfaced. Trusting the real measurement instead,
+ * labeled `approximate` so the user knows it came from outside the script's
+ * expected gap, is strictly better than either. The ONLY thing that still
+ * legitimately blocks tier 2 from committing is a resulting non-positive
+ * duration on either side of the pair — including the NEIGHBORING pair's own
+ * boundary, since an unclamped target can now reach far enough to threaten
+ * it — which is why that check stays with the caller (`applyBoundaryWatcher`/
+ * `verifyCommittedBoundaries`), which alone has `curr.startTime`/
+ * `next.startTime`/`next.duration` in scope.
+ *
+ * Pure; exported for direct unit testing.
+ */
+export function resolveCorrectionCandidate(m: BoundaryQualityMeasurement): CorrectionCandidate | null {
+  if (m.center === undefined) return null;
+
+  if (m.center > m.lastSpokenEnd && m.center < m.nextSpokenStart) {
+    return { target: m.center, source: 'center', approximate: false };
+  }
+
+  return { target: m.center, source: 'region-center-approximate', approximate: true };
+}
+
+// ---------------------------------------------------------------------------
+// Boundary watcher — Phase 2 of the waveform-watcher program (auto-correction
+// of flagged fallback boundaries). Builds directly on `measureFallbackBoundary`
+// above; the calibrated dual-gate constants are frozen for this phase (no
+// threshold changes — see syncConstants.ts's own header on how those were
+// calibrated).
+// ---------------------------------------------------------------------------
+
+/** One boundary this pass actually moved. */
+export interface BoundaryCorrection {
+  /** Index into `segments` of the pair's FIRST (earlier) segment — matches
+   *  `BoundaryQualityMeasurement.segmentIndex`. */
+  pairIndex: number;
+  oldBoundary: number;
+  newBoundary: number;
+  oldAmplitude: number;
+  newAmplitude: number;
+  /** Correction placement semantics fix (2026-08-02) — carried straight from
+   *  `CorrectionCandidate.approximate`: `true` when `newBoundary` landed
+   *  outside this pair's own transcribed token gap (a real measured quiet
+   *  spot the script's word timestamps didn't predict), `false` for the
+   *  ideal in-gap case. Optional so older, already-persisted log entries
+   *  (built before this field existed) decode without it. */
+  approximate?: boolean;
+}
+
+/**
+ * Auto-corrects flagged fallback boundaries by moving them into the nearest
+ * genuinely quiet gap `findQuietestRegion` can find inside the pair's own
+ * search window — the same window `snapCoveredBoundaries` searched for a
+ * silence and came up empty. Architecture B: a post-hoc pass over the FINAL
+ * committed `segments` array; never reorders or re-runs
+ * `snapCoveredBoundaries`/`alignScenestoTranscript`, never touches either
+ * function's signature.
+ *
+ * A pair is corrected whenever:
+ *   (a) `measureFallbackBoundary` returns non-null AND `flagged` — this
+ *       already encodes "used the plain fallback" (a silence-placed boundary
+ *       is never returned at all) AND the full calibrated dual gate
+ *       (amplitude floor, min distance, loudness ratio) AND "neither segment
+ *       is locked" (mirrors `snapCoveredBoundaries`' own guard) — one shared
+ *       implementation, so none of these can drift between the checker and
+ *       the watcher;
+ *   (b) `resolveCorrectionCandidate` returns a non-null candidate — `null`
+ *       means no quiet region was found at all (tier 3); this pair is left
+ *       UNCHANGED and reported as a skip (see below), never midpoint-guessed;
+ *   (c) the resulting curr/next durations both stay positive — including the
+ *       NEIGHBORING pair's own boundary, since tier 2's target (Correction
+ *       placement semantics fix, 2026-08-02 — see `resolveCorrectionCandidate`'s
+ *       own doc comment) is no longer clamped into the pair's own real token
+ *       gap and can in principle reach far enough to threaten it. This is the
+ *       ONLY thing that still blocks a tier-1/tier-2 candidate from
+ *       committing.
+ *
+ * A pair left uncorrected here — either (b) or (c) above — is NOT reported
+ * by this function directly; `verifyCommittedBoundaries` (below), which runs
+ * immediately after over the segments THIS function just produced, re-
+ * measures every pair fresh and surfaces anything still flagged-and-
+ * uncorrected via its own `stillFlagged` (identity-excluding whatever THIS
+ * pass's `corrections` already fixed) — one shared reporting path instead of
+ * two independent ones that could drift.
+ *
+ * PAIRED WRITE: exactly two fields move per correction —
+ * `segments[i].duration` (recomputed so its end lands at the new boundary)
+ * and `segments[i+1].startTime`/`anchorStart` (moved to the new boundary) —
+ * the same two-field discipline `snapCoveredBoundaries`' own Pass 3 uses.
+ * `segments[i+1].duration` is deliberately NOT touched: its own end (the
+ * NEXT pair's boundary) is untouched by this pair's correction, exactly as
+ * `snapCoveredBoundaries` already lets one boundary write ripple forward
+ * through an unchanged `duration` when segments are re-tiled left to right.
+ *
+ * ORDER INDEPENDENCE: `measureFallbackBoundary` never reads `curr.startTime`/
+ * `curr.duration`/`next.duration` — only `curr.locked`/`next.locked` and
+ * `next.startTime` (the pair's OWN boundary, not the pair before it) — so
+ * correcting pair `i` can never change whether pair `i+1` is eligible, or
+ * where pair `i+1`'s own quiet point is. The one thing that DOES chain
+ * left-to-right is the final write: `curr.duration = newBoundary -
+ * curr.startTime` reads whatever `curr.startTime` is AT THAT MOMENT, which is
+ * exactly right — if pair `i-1` was also corrected, `segments[i].startTime`
+ * already reflects that, and this pair's write keeps the chain contiguous
+ * instead of reintroducing a gap or overlap.
+ *
+ * Same contiguity safety net `snapCoveredBoundaries` uses after every write:
+ * re-derives `curr.startTime + curr.duration` post-rounding and nudges
+ * `next.startTime`/`anchorStart` forward if float rounding pushed it past the
+ * intended boundary, so `startTime[i] + duration[i] === startTime[i+1]` holds
+ * exactly, not approximately, for every corrected pair.
+ *
+ * Returns `{ segments, corrections: [] }` with `segments` returned BY
+ * IDENTITY (no copy) when `waveformSource` is `null` — there is nothing to
+ * measure against. Otherwise always returns a fresh shallow-copied array
+ * (never mutates the input), matching `snapCoveredBoundaries`'s own purity
+ * contract, even when zero corrections end up applying.
+ *
+ * Pure; exported for direct unit testing.
+ */
+export function applyBoundaryWatcher(
+  segments: VideoSegment[],
+  keptAlignments: SegmentAlignment[],
+  tokens: TranscriptToken[],
+  silences: SilenceInterval[],
+  waveformSource: WaveformSource | null,
+): { segments: VideoSegment[]; corrections: BoundaryCorrection[] } {
+  if (!waveformSource) return { segments, corrections: [] };
+
+  const out: VideoSegment[] = segments.map(s => ({ ...s }));
+  const corrections: BoundaryCorrection[] = [];
+
+  for (let i = 0; i < out.length - 1; i++) {
+    const curr = out[i];
+    const next = out[i + 1];
+    const currAlign = keptAlignments[i];
+    const nextAlign = keptAlignments[i + 1];
+    if (!curr || !next || !currAlign || !nextAlign) continue;
+
+    const measurement = measureFallbackBoundary(
+      i, curr, next, currAlign, nextAlign, tokens, silences, waveformSource,
+      BOUNDARY_QUALITY_LOUDNESS_RATIO_K, BOUNDARY_QUALITY_SUSTAINED_WINDOW_SEC,
+    );
+    if (!measurement || !measurement.flagged) continue;
+
+    const candidate = resolveCorrectionCandidate(measurement);
+    if (!candidate) {
+      // Tier 3 — findQuietestRegion found nothing at all to measure. Leave
+      // the pair unchanged; verifyCommittedBoundaries's fresh re-measurement
+      // picks it up as stillFlagged (same measurement.flagged/center
+      // relationship holds there too).
+      if (import.meta.env.DEV) {
+        console.warn(
+          '[boundary-watcher] no quiet region found — pair (%d,%d) left unchanged',
+          i, i + 1,
+        );
+      }
+      continue;
+    }
+    if (import.meta.env.DEV && candidate.approximate) {
+      console.info(
+        '[boundary-watcher] approximate placement (region center outside the script\'s expected gap) — pair (%d,%d): target=%ss',
+        i, i + 1, candidate.target.toFixed(3),
+      );
+    }
+
+    const snapped = round3(candidate.target);
+    const newCurrDuration = round3(snapped - curr.startTime);
+    // `next`'s own real end — the boundary with the NEIGHBORING pair
+    // (segments[i+2], read via next.startTime + next.duration since
+    // next.duration is never touched by this pass) — computed BEFORE this
+    // pair's write below. Tier 2's target is no longer clamped into this
+    // pair's own real token gap, so it can in principle reach far enough to
+    // threaten that neighboring boundary; this is the "i+2's start sanity"
+    // bound, alongside the existing "i+1's start" (newCurrDuration) bound.
+    const nextEnd = round3(next.startTime + next.duration);
+    const newNextDuration = round3(nextEnd - snapped);
+
+    // The ONLY remaining skip path — reject rather than clamp: a
+    // non-positive duration on either side (including the neighboring
+    // pair's own boundary) means the computed correction is not
+    // trustworthy, however it was derived.
+    if (newCurrDuration <= 0 || newNextDuration <= 0) {
+      if (import.meta.env.DEV) {
+        console.warn(
+          '[boundary-watcher] degenerate correction — pair (%d,%d) skipped: newCurrDuration=%s newNextDuration=%s',
+          i, i + 1, newCurrDuration, newNextDuration,
+        );
+      }
+      continue;
+    }
+
+    const oldBoundary = measurement.boundaryTime;
+    const oldAmplitude = measurement.boundaryAmplitude;
+
+    curr.duration = newCurrDuration;
+    next.startTime = snapped;
+    next.anchorStart = snapped;
+
+    // Contiguity safety net (mirrors snapCoveredBoundaries's own Pass 3):
+    // float rounding of the diff above could in principle push curr's own
+    // end a hair past `snapped` — re-derive and nudge next forward so the
+    // invariant holds exactly, not approximately.
+    const contiguousStart = round3(curr.startTime + curr.duration);
+    if (contiguousStart > next.startTime) {
+      next.startTime = contiguousStart;
+      next.anchorStart = contiguousStart;
+    }
+
+    corrections.push({
+      pairIndex: i,
+      oldBoundary,
+      newBoundary: next.startTime,
+      oldAmplitude,
+      newAmplitude: measurement.quietestAmplitude ?? 0,
+      approximate: candidate.approximate,
+    });
+  }
+
+  return { segments: out, corrections };
+}
+
+// ---------------------------------------------------------------------------
+// Boundary verifier — Watcher follow-up, Defect A. Runs immediately AFTER
+// `applyBoundaryWatcher` above, over the segments IT just produced, and
+// widens the check to boundaries the watcher never looked at: silence-placed
+// ones (`usedFallback === false`) whose committed position still measures as
+// loud relative to a real, quieter alternative nearby — the detected silence
+// interval itself was not necessarily the acoustically quietest point in the
+// pair's own window.
+// ---------------------------------------------------------------------------
+
+/**
+ * Verifies every adjacent pair's FINAL committed boundary (post-watcher)
+ * against the same calibrated dual gate, and conditionally corrects the
+ * silence-placed pairs the watcher never touches (Option C, user-approved).
+ *
+ * `watcherCorrections` — `applyBoundaryWatcher`'s own `corrections` from the
+ * pass that ran immediately before this one, over the SAME segments array
+ * (Log-consistency fix). Re-measuring a just-corrected fallback pair can
+ * still legitimately come back `flagged`: the dual gate's distance/ratio
+ * check compares the NEW committed boundary's own amplitude against
+ * `quietestTime`'s mean amplitude, and even a real, approximate placement
+ * (`resolveCorrectionCandidate`'s tier 2 — the pair's own measured region
+ * center, not necessarily the single loudest-relief point `findQuietestRegion`
+ * found) can still sit measurably louder than that single global minimum —
+ * so a pair the watcher genuinely improved (moved off the loud spike, onto a
+ * real quiet region) can still measure "still loud relative to the single
+ * quietest point in the window". That is not a second failure to report — it
+ * is the same finding the watcher already acted on. `pairIndex` is the shared
+ * identity between a
+ * `BoundaryCorrection` and a `BoundaryQualityMeasurement.segmentIndex`; any
+ * pair index present here is skipped entirely (no `stillFlagged` push, no
+ * second correction attempt) — a corrected pair must never also warn.
+ *
+ * Per pair:
+ *   - Not flagged (or ineligible — locked/missing alignment/no quiet region
+ *     found): no entry, no correction, nothing to report.
+ *   - Flagged AND `usedFallback` AND already in `watcherCorrections`: the
+ *     watcher already fixed this pair — skip silently (see above).
+ *   - Flagged AND `usedFallback` AND NOT in `watcherCorrections`: the
+ *     watcher genuinely gave up on this pair (a degenerate resulting
+ *     duration — its only remaining skip path, `resolveCorrectionCandidate`
+ *     never itself withholds a target). This function does not attempt a
+ *     second correction for the same pair (that would duplicate the
+ *     watcher's own job, using the exact same target it already rejected);
+ *     the measurement is surfaced via `stillFlagged` as a real warning
+ *     instead of silently dropping it.
+ *   - Flagged AND NOT `usedFallback` (a silence-placed boundary that still
+ *     measures loud): corrected via `resolveCorrectionCandidate` — the
+ *     region center when it lands strictly inside the pair's own real token
+ *     gap (exact), else that same real measured center used anyway
+ *     (approximate) — same two-tier placement the watcher uses; see that
+ *     function's own doc comment for the Correction placement semantics fix,
+ *     2026-08-02 — PROVIDED the resulting curr/next durations both stay
+ *     positive (including the NEIGHBORING pair's own boundary — same "i+2's
+ *     start sanity" bound `applyBoundaryWatcher` enforces, since an
+ *     approximate target is no longer clamped into this pair's own gap). A
+ *     non-positive duration, or `resolveCorrectionCandidate` returning `null`
+ *     (tier 3 — no quiet region found at all), is what leaves this pair
+ *     WARNING-only: the measurement goes to `stillFlagged`, the boundary is
+ *     left exactly where `snapCoveredBoundaries` put it.
+ *
+ * Same PAIRED WRITE discipline, same order-independent measurement /
+ * left-to-right chained write, and the same post-write contiguity safety net
+ * as `applyBoundaryWatcher` (see that function's own doc comment — every
+ * invariant it documents holds here identically; this is not a
+ * re-implementation, it is the same shape applied to a different eligibility
+ * rule).
+ *
+ * Returns `{ segments, corrections: [], stillFlagged: [] }` with `segments`
+ * returned BY IDENTITY (no copy) when `waveformSource` is `null`. Otherwise
+ * always returns a fresh shallow-copied array (never mutates the input),
+ * even when zero corrections end up applying.
+ *
+ * Pure; exported for direct unit testing.
+ */
+export function verifyCommittedBoundaries(
+  segments: VideoSegment[],
+  keptAlignments: SegmentAlignment[],
+  tokens: TranscriptToken[],
+  silences: SilenceInterval[],
+  waveformSource: WaveformSource | null,
+  watcherCorrections: readonly BoundaryCorrection[] = [],
+): { segments: VideoSegment[]; corrections: BoundaryCorrection[]; stillFlagged: BoundaryQualityMeasurement[] } {
+  if (!waveformSource) return { segments, corrections: [], stillFlagged: [] };
+
+  const watcherCorrectedIndices = new Set(watcherCorrections.map(c => c.pairIndex));
+  const out: VideoSegment[] = segments.map(s => ({ ...s }));
+  const corrections: BoundaryCorrection[] = [];
+  const stillFlagged: BoundaryQualityMeasurement[] = [];
+
+  for (let i = 0; i < out.length - 1; i++) {
+    const curr = out[i];
+    const next = out[i + 1];
+    const currAlign = keptAlignments[i];
+    const nextAlign = keptAlignments[i + 1];
+    if (!curr || !next || !currAlign || !nextAlign) continue;
+
+    const measurement = measureBoundaryQuality(
+      i, curr, next, currAlign, nextAlign, tokens, silences, waveformSource,
+      BOUNDARY_QUALITY_LOUDNESS_RATIO_K, BOUNDARY_QUALITY_SUSTAINED_WINDOW_SEC,
+    );
+    if (!measurement || !measurement.flagged) continue;
+
+    if (measurement.usedFallback) {
+      // Already handled by applyBoundaryWatcher, which runs immediately
+      // before this pass and shares this exact measurement function.
+      if (watcherCorrectedIndices.has(i)) continue; // corrected — never also warn
+      // The watcher genuinely gave up on this pair (degenerate duration) —
+      // surface it, don't re-attempt it with the same target it rejected.
+      stillFlagged.push(measurement);
+      continue;
+    }
+
+    // Silence-placed pair failing the gate (Option C) — resolve a target via
+    // the same two-tier placement the watcher uses.
+    const candidate = resolveCorrectionCandidate(measurement);
+    if (!candidate) {
+      // Tier 3 — findQuietestRegion found nothing at all to measure.
+      stillFlagged.push(measurement);
+      continue;
+    }
+    if (import.meta.env.DEV && candidate.approximate) {
+      console.info(
+        '[boundary-verify] approximate placement (region center outside the script\'s expected gap) — pair (%d,%d): target=%ss',
+        i, i + 1, candidate.target.toFixed(3),
+      );
+    }
+
+    const snapped = round3(candidate.target);
+    const newCurrDuration = round3(snapped - curr.startTime);
+    // Neighboring-pair sanity bound — see applyBoundaryWatcher's identical
+    // check for the full rationale.
+    const nextEnd = round3(next.startTime + next.duration);
+    const newNextDuration = round3(nextEnd - snapped);
+
+    if (newCurrDuration <= 0 || newNextDuration <= 0) {
+      if (import.meta.env.DEV) {
+        console.warn(
+          '[boundary-verify] degenerate correction — pair (%d,%d) skipped: newCurrDuration=%s newNextDuration=%s',
+          i, i + 1, newCurrDuration, newNextDuration,
+        );
+      }
+      stillFlagged.push(measurement);
+      continue;
+    }
+
+    const oldBoundary = measurement.boundaryTime;
+    const oldAmplitude = measurement.boundaryAmplitude;
+
+    curr.duration = newCurrDuration;
+    next.startTime = snapped;
+    next.anchorStart = snapped;
+
+    // Contiguity safety net (mirrors applyBoundaryWatcher's own).
+    const contiguousStart = round3(curr.startTime + curr.duration);
+    if (contiguousStart > next.startTime) {
+      next.startTime = contiguousStart;
+      next.anchorStart = contiguousStart;
+    }
+
+    corrections.push({
+      pairIndex: i,
+      oldBoundary,
+      newBoundary: next.startTime,
+      oldAmplitude,
+      newAmplitude: measurement.quietestAmplitude ?? 0,
+      approximate: candidate.approximate,
+    });
+  }
+
+  return { segments: out, corrections, stillFlagged };
+}
