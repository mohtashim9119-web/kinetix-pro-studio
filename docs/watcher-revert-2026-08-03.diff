+    // region spans close to the full 2.0s pause, centered near its middle.
+    expect(deltaResult.regionStart).toBeCloseTo(1.0, 6);
+    expect(deltaResult.regionEnd).toBeCloseTo(3.0, 6);
+    expect(deltaResult.regionEnd - deltaResult.regionStart).toBeGreaterThan(1.0);
