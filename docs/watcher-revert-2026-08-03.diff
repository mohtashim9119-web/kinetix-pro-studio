+    const quietestMeanAmplitude = 0.002;
+
+    const deltaThreshold = quietestMeanAmplitude + BOUNDARY_QUALITY_REGION_END_DELTA; // 0.052
+    const deltaResult = findSilenceRegionCenter(peaks, 10, seedTimeSec, deltaThreshold, 0.5, 3.5);
