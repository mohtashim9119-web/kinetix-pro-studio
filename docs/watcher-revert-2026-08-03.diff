+    // The core claim: the frozen absolute-delta formula yields a genuinely
+    // wider region than the rejected ratio formula for the identical seed.
+    expect(deltaResult.regionEnd - deltaResult.regionStart)
+      .toBeGreaterThan(ratioResult.regionEnd - ratioResult.regionStart);
+  });
