+/**
+ * Heavy, currentTime-independent portion of the timeline: the heading lane, the
+ * segment track (thumbnails) and the voiceover waveform. Split out and wrapped
+ * in React.memo so that a playback tick — which changes only `currentTime` on
+ * the parent — no longer re-renders the ~294 segment rows or the waveform.
+ *
+ * Deliberately does NOT receive `currentTime`. Everything here changes only on
+ * real edits (segments/assets/headings), zoom (pixelsPerSecond), the active
+ * segment crossing a boundary (currentSegmentId) or a resize gesture. All
+ * callback props are stabilized by the parent (App.tsx useCallback / the
+ * useCallback'd handleHeadingResizeStart), so the memo actually holds when only
+ * currentTime changes.
+ */
+interface TimelineContentProps {
+  segments: VideoSegment[];
+  assets: Asset[];
+  headings: HeadingOverlay[];
+  currentSegmentId: string | undefined;
+  isSynced: boolean;
+  pixelsPerSecond: number;
+  totalDuration: number;
+  segmentStarts: number[];
+  waveformBars: number[];
+  containerWidth: number;
+  voiceoverName: string | undefined;
+  resizingId: string | null;
+  isAdjustingTrim: boolean;
+  trimmingSegmentId: string | null;
+  onSeek: (time: number) => void;
+  onResizeStart: (id: string, type: 'start' | 'end') => void;
+  onSegmentUpdate: (updater: (prev: VideoSegment[]) => VideoSegment[]) => void;
+  onOpenStockSearch: (segmentId: string) => void;
+  onSelectSegment?: (id: string) => void;
+  onHeadingResizeStart: (e: React.MouseEvent, heading: HeadingOverlay, edge: 'start' | 'end') => void;
+}
+
+const TimelineContent = memo(function TimelineContent({
+  segments,
+  assets,
+  headings,
+  currentSegmentId,
+  isSynced,
+  pixelsPerSecond,
+  totalDuration,
+  segmentStarts,
+  waveformBars,
+  containerWidth,
+  voiceoverName,
+  resizingId,
+  isAdjustingTrim,
+  trimmingSegmentId,
+  onSeek,
+  onResizeStart,
+  onSegmentUpdate,
+  onOpenStockSearch,
+  onSelectSegment,
+  onHeadingResizeStart,
+}: TimelineContentProps) {
+  // ---------------------------------------------------------------------------
+  // Waveform — fixed-size canvas TILES (replaces the former single sticky
+  // canvas + scroll-redraw, which itself replaced ~8,000 bar <div>s).
+  //
+  // The lane is `totalDuration * pixelsPerSecond` wide (up to ~126,000px on a
+  // 21-min project at max zoom). Rather than one full-width canvas (whose
+  // DPR-scaled backing store breaches WebKit's ~16.77M px² limit in the
+  // Retina + long-project + max-zoom corner) OR one viewport-pinned sticky
+  // canvas that had to REDRAW on every scroll event (which turned the App-level
+  // playhead-follow auto-scroll into a per-frame canvas repaint — the confirmed
+  // regression), the waveform is drawn into a row of fixed 2048px-wide canvas
+  // tiles, each absolutely positioned at `left: i * TILE` inside the lane.
+  //
+  // Consequences that matter:
+  //   • Scrolling — manual OR the App.tsx playhead-follow auto-scroll — is now
+  //     PURE native browser scroll. NOTHING here listens to 'scroll'. The tiles
+  //     are ordinary positioned DOM; the browser just translates them.
+  //   • Each tile draws ONCE, from `waveformBars`, when it mounts or when its
+  //     inputs change (waveformBars / totalDuration / pixelsPerSecond → and thus
+  //     tile count/boundaries). currentTime is never a dependency.
+  //   • Per-tile backing store at 2048×80 CSS × DPR 2 = 4096×160 = 655,360 px²,
+  //     ~25× under WebKit's ~16.77M px² per-canvas area limit.
+  //
+  // Bars are sampled on the GLOBAL 3px content grid (not tile-local), so the
+  // bar rhythm is continuous across tile seams — a bar never straddles a
+  // boundary with a phase jump. The per-segment hit-target <div>s below keep
+  // every existing interaction (resize handles, data-seg-id live-resize targets,
+  // active-segment tint) with byte-identical geometry.
+  // ---------------------------------------------------------------------------
+  const WAVEFORM_TILE_WIDTH_PX = 2048; // CSS px per tile (constant)
+  const WAVEFORM_LANE_HEIGHT_PX = 80;  // matches the h-20 lane height
+
+  const totalContentWidth = totalDuration * pixelsPerSecond;
+  const tileCount = totalContentWidth > 0
+    ? Math.ceil(totalContentWidth / WAVEFORM_TILE_WIDTH_PX)
+    : 0;
+
+  const tileCanvasRefs = useRef<(HTMLCanvasElement | null)[]>([]);
+
+  // Draw one tile: its own sub-range [tileLeft, tileLeft + tileW) of the
+  // waveform, reusing the exact bucket/peak/height math of the former single
+  // canvas — just offset to global content-pixel space and clipped to the tile.
+  const drawTile = useCallback((index: number, canvas: HTMLCanvasElement) => {
+    const ctx = canvas.getContext('2d');
+    if (!ctx) return;
+    const dpr = window.devicePixelRatio || 1;
