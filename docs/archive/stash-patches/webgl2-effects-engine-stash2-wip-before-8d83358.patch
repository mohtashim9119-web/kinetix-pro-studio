-  if (!dragged) return originalSegments;
-  if (Math.abs(finalDuration - dragged.duration) < NEGLIGIBLE_DRAG_SEC) return originalSegments;
-  return computeDragCascade(
-    originalSegments,
-    draggedIdx,
-    finalDuration,
-    finalTrimStart,
-    direction,
-    () => undefined,
-    tokens,
-  ) ?? originalSegments;
-}
